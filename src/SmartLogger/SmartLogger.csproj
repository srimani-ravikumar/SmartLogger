<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>SmartLogger</PackageId>
    
    <!-- 
      Default version for local builds.
      In CI/CD, this value is overridden by the Git tag (via /p:Version).
    -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    
    <Authors>Srimani</Authors>

    <Description>
      SmartLogger is a production-focused, extensible logging framework for .NET with support for structured logging, correlation context, runtime configuration reload, and multi-destination output. Designed with concurrency safety and system resilience in mind.
    </Description>

    <PackageTags>
      logging;logger;dotnet;observability;correlation-id;structured-logging;
      runtime-configuration;thread-safe;async;diagnostics;monitoring
    </PackageTags>

    <RepositoryUrl>https://github.com/srimani-ravikumar/SmartLogger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/srimani-ravikumar/SmartLogger</PackageProjectUrl>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageIcon>Icon.png</PackageIcon>

    <PackageReadmeFile>docs/package-readme.md</PackageReadmeFile>
    
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets/Icon.png" Pack="true" PackagePath="\" />

    <None Include="../../docs/package-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>