<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="bin\Debug\net8.0\xmlconfigurationfile.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin\Debug\net8.0\smartlogger.json" />
  </ItemGroup>

  <!-- Reload battle-test config: live-copied to output so scripts/ can mutate the running copy. -->
  <ItemGroup>
    <None Include="smartlogger.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- <ItemGroup>
    <PackageReference Include="SmartLogger" Version="4.0.1" />
  </ItemGroup> -->

  <ItemGroup>
    <ProjectReference Include="..\SmartLogger\SmartLogger.csproj" />
  </ItemGroup>

</Project>
